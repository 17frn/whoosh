# Android SDK Path
# Set this to your Android SDK installation directory

# Linux/Mac example:
ANDROID_HOME=$HOME/Android/Sdk

# Windows example:
# ANDROID_HOME=C:\Users\YourUsername\AppData\Local\Android\Sdk

# Development Server IP (optional)
# Leave commented for auto-detection, or set manually:
# DEV_SERVER_IP=192.168.0.100
